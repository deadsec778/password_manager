# .env.example - Application Configuration

# Flask Application Settings
FLASK_APP=api/dashboard_app.py
FLASK_ENV=production
FLASK_SECRET_KEY=change_me_to_a_secure_random_string

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=password

# Redis Configuration (Implementation Pending)
REDIS_ACTIVE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Admin Master Recovery Key
ADMIN_GLOBAL_KEY=
