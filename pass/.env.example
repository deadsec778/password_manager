# .env.example - Application Configuration

# Flask Application Settings
FLASK_APP=api/dashboard_app.py
FLASK_ENV=production
FLASK_SECRET_KEY=change_me_to_a_secure_random_string

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=password

# Redis Configuration (Implementation Pending)
REDIS_ACTIVE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Admin Master Recovery Key
ADMIN_GLOBAL_KEY=

# ==============================================================================
# INTEGRATIONS & FEATURE FLAGS CONFIGURATION
# ==============================================================================
# Master switch for all external third-party & cloud integrations.
# When set to 'false', the application runs in 100% offline / local LAN mode.
# No external network requests will be made, Google OAuth button will be hidden,
# and account registration will work locally without requiring email verification.
INTEGRATIONS_ENABLED=true

# --- Google OAuth SSO Integration ---
# Enable or disable Google Single Sign-On specifically.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/callback/google

# --- Gmail SMTP & Email OTP Integration ---
# Enable or disable email delivery for OTP verification, password resets, & security alerts.
# If disabled, signup creates accounts directly and password resets notify the user to contact admin.
GMAIL_INTEGRATION_ENABLED=true
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USE_TLS=true

# --- Future Integration Modules (Ready for extension) ---
# DISCORD_INTEGRATION_ENABLED=false
# TELEGRAM_INTEGRATION_ENABLED=false
# SLACK_INTEGRATION_ENABLED=false
# LDAP_INTEGRATION_ENABLED=false
# S3_BACKUP_INTEGRATION_ENABLED=false
